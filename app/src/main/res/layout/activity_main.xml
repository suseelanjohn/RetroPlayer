<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout android:id="@+id/page0" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
    <com.retro.player.VinylView android:id="@+id/vinyl" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp" android:background="#102010">
        <TextView android:id="@+id/title" android:text="NO TRACK" android:textColor="#33FF33" android:typeface="monospace" android:textSize="15sp" android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever" android:focusable="true" android:focusableInTouchMode="true" android:padding="10dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <ImageButton android:id="@+id/b_like" style="@style/IconBtn" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_heart"/>
    </LinearLayout>
    <SeekBar android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:progressTint="#33FF33" android:thumbTint="#33FF33" android:progressBackgroundTint="#0F4A0F"/>
    <TextView android:id="@+id/time" android:text="00:00 / 00:00" android:textColor="#33FF33" android:typeface="monospace" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
        <ImageButton android:id="@+id/b_shuf" style="@style/IconBtn" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_shuffle"/>
        <ImageButton android:id="@+id/b_prev" style="@style/IconBtn" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_prev"/>
        <ImageButton android:id="@+id/b_play" style="@style/IconBtn" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_play"/>
        <ImageButton android:id="@+id/b_next" style="@style/IconBtn" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_next"/>
        <ImageButton android:id="@+id/b_rep" style="@style/IconBtn" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_repeat"/>
    </LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/page1" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView style="@style/Head" android:text="&gt; LIBRARY" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ListView android:id="@+id/list_all" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#1A3A1A" android:dividerHeight="1dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/page2" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView style="@style/Head" android:text="&gt; LIKED &lt;3" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/empty2" android:text="&gt; NOTHING LIKED YET. LONG-PRESS A TRACK OR TAP THE HEART." android:visibility="gone" android:padding="12dp" android:textColor="#33FF33" android:typeface="monospace" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ListView android:id="@+id/list_liked" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#1A3A1A" android:dividerHeight="1dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/page3" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView style="@style/Head" android:text="&gt; TOP PLAYED" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/empty3" android:text="&gt; NO PLAYS YET." android:visibility="gone" android:padding="12dp" android:textColor="#33FF33" android:typeface="monospace" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ListView android:id="@+id/list_top" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#1A3A1A" android:dividerHeight="1dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/page4" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView style="@style/Head" android:text="&gt; SETTINGS" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:id="@+id/settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
</LinearLayout>
</FrameLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0F4A0F"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:background="#061406">
<LinearLayout android:id="@+id/nav0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true"><ImageView android:id="@+id/ni0" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_disc"/><TextView android:id="@+id/nl0" android:text="PLAYER" android:textSize="9sp" android:typeface="monospace" android:textColor="#33FF33" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/></LinearLayout>
<LinearLayout android:id="@+id/nav1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true"><ImageView android:id="@+id/ni1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_list"/><TextView android:id="@+id/nl1" android:text="LIBRARY" android:textSize="9sp" android:typeface="monospace" android:textColor="#33FF33" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/></LinearLayout>
<LinearLayout android:id="@+id/nav2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true"><ImageView android:id="@+id/ni2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_heart"/><TextView android:id="@+id/nl2" android:text="LIKED" android:textSize="9sp" android:typeface="monospace" android:textColor="#33FF33" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/></LinearLayout>
<LinearLayout android:id="@+id/nav3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true"><ImageView android:id="@+id/ni3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_bars"/><TextView android:id="@+id/nl3" android:text="TOP" android:textSize="9sp" android:typeface="monospace" android:textColor="#33FF33" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/></LinearLayout>
<LinearLayout android:id="@+id/nav4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true"><ImageView android:id="@+id/ni4" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_sliders"/><TextView android:id="@+id/nl4" android:text="SETUP" android:textSize="9sp" android:typeface="monospace" android:textColor="#33FF33" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/></LinearLayout>
</LinearLayout>
</LinearLayout>
<com.retro.player.ScanlineView android:id="@+id/scan" android:layout_width="match_parent" android:layout_height="match_parent"/>
</FrameLayout>
